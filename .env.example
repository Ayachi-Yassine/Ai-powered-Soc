# Settings and secrets the SOCPilot stack needs.
# Set these as n8n credentials / environment variables and on the relevant VMs.
# NEVER commit real values.

# --- AI layer (n8n HTTP Request node) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Notifications (n8n Telegram node) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Wazuh -> n8n webhook (ossec.conf <hook_url>) ---
WAZUH_WEBHOOK_URL=http://<N8N_HOST>:5678/webhook/wazuh-alert

# --- SSH chain to pfSense (scripts/pfsense_block.sh, scripts/block_ip.sh) ---
# On the SOC VM: how to reach the Ubuntu router
ROUTER_USER=
ROUTER_HOST=
# On the Ubuntu router: how to reach pfSense
PFSENSE_USER=admin
PFSENSE_HOST=192.168.1.1
# Prefer SSH keys. If you must use a password, export it only in the shell
# that runs the script (sshpass -e reads it from here).
SSHPASS=
